{
  "schemaVersion": 1,
  "id": "dou-link",
  "projectId": "dou-link",
  "projectName": "抖音链接气泡",
  "projectDescription": "复制抖音视频链接时，在鼠标附近显示气泡；点击后用默认浏览器打开。",
  "name": "剪贴板链接监听",
  "version": "1.0.0",
  "projectRoot": "..\\dou-link",
  "requiresAdmin": false,
  "singleInstance": true,
  "timeoutSeconds": 90,
  "actions": {
    "run": {
      "program": "{console_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action", "run",
        "--root", "{project_root}",
        "--result-path", "{result_path}",
        "--log-path", "{log_path}"
      ]
    },
    "stop": {
      "program": "{console_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action", "stop",
        "--root", "{project_root}",
        "--result-path", "{result_path}",
        "--log-path", "{log_path}"
      ]
    }
  }
}
