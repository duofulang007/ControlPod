{
  "schemaVersion": 1,
  "id": "runner-lab",
  "projectId": "runner-lab",
  "projectName": "跑步数据分析",
  "projectDescription": "小米运动健康导出包 → 本地跑步看板。只读取跑步相关的两个成员，其余成员（含个人信息）一律不打开。",
  "name": "跑步数据导入",
  "version": "1.1.0",
  "projectRoot": "..\\runner-lab",
  "requiresAdmin": false,
  "singleInstance": true,
  "timeoutSeconds": 900,
  "actions": {
    "run": {
      "program": "{console_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "run",
        "--gui",
        "--root",
        "{project_root}",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    },
    "stop": {
      "program": "{console_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "stop",
        "--gui",
        "--root",
        "{project_root}",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    },
    "restart": {
      "program": "{console_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "restart",
        "--gui",
        "--root",
        "{project_root}",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    }
  }
}
