<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ApexShell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 免安装绿色运行：.NET 运行时 + Windows App SDK 运行时全部随包带走 -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 非打包（无 MSIX）：符合「单 exe 目录、双击就跑」的定位 -->
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 关键：非 MSIX 打包也必须开。不开的话 PRI 生成会回退到 VS 才有的
         AppxPackage 任务程序集，dotnet CLI 直接 MSB4062（WindowsAppSDK#3548/#3939）；
         开了之后走 WinAppSDK 包内自带的 WinAppSdkGenerateProjectPriFile 任务 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release 发布（日常入口用它）：预编译成 ReadyToRun，冷启动不再现 JIT 上万个方法；
       符号一并关掉，省掉启动时的 PDB 查找与磁盘读。Debug 只用于调试，不受影响。
       实测背景：SelfContained + WinAppSDK 自带 200+ 个 DLL，纯托管冷加载一段就占 ~1.5s，
       dotnet publish -c Release 能把这段砍掉大半。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- C# 本地 API 直接读写 SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\app.js" Link="wwwroot\app.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\styles.css" Link="wwwroot\styles.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\web\**\*.js" Link="wwwroot\web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
