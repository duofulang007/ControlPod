# Local Python environment and runtime data
backend/.venv/
backend/data/
**/test-tmp/
**/.pytest_cache/
**/.pytest-*/
**/pytest-cache-files-*/
backend/**/__pycache__/
backend/**/*.py[cod]

# Local test caches
__pycache__/

# Machine-specific settings and transient output
.env
.env.*
!.env.example
*.log

# Generated visual-check evidence; source documents remain tracked
backend/docs/*.visual-check.*

# Agent tooling metadata (local notes, never part of the deliverable)
.workbuddy/
.workbuddy-ai/

# run-analytics is an independent git repo at ..\run-analytics (per-module repos policy):
# it manages its own history and health data; this repo tracks nothing under it.
run-analytics/

# WinUI shell (apex-console/shell): C# build artifacts
shell/bin/
shell/obj/
shell/*.user
shell/.vs/
