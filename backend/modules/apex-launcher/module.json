{
  "schemaVersion": 1,
  "id": "apex-launcher",
  "projectId": "apex",
  "name": "APEX 一键启动",
  "version": "1.1.0",
  "projectRoot": "{console_root}",
  "requiresAdmin": true,
  "singleInstance": true,
  "timeoutSeconds": 240,
  "actions": {
    "run": {
      "program": "{project_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "run",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    },
    "stop": {
      "program": "{project_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "stop",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    },
    "restart": {
      "program": "{project_root}\\backend\\.venv\\Scripts\\python.exe",
      "cwd": "{module_dir}",
      "args": [
        "{module_dir}\\runner.py",
        "--action",
        "restart",
        "--result-path",
        "{result_path}",
        "--log-path",
        "{log_path}"
      ]
    }
  }
}
